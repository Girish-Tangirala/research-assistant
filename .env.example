# Optional, non-secret settings. Copy to .env if you want to change defaults.
# Sign-ins (Claude API key, Git tokens, OpenAlex key) are entered in the app
# and stored in the system credential vault - do NOT put them here.

AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high            # low | medium | high | xhigh | max
AGENT_MAX_TOKENS=32000
AGENT_MAX_STEPS=40
AGENT_SERVER_FALLBACKS=true  # server-side refusal fallbacks (Claude API only)
# AGENT_WORKSPACE=C:/Users/you/.research_agent

GIT_PUSH_STRATEGY=auto       # auto | feature-branch | merge-to-default

LATEX_COMPILER=latexmk       # latexmk | pdflatex
# latexmk is used only when Perl is installed; otherwise pdflatex/xelatex + bibtex/biber.
# LATEXMK_PATH=C:/texlive/2026/bin/windows/latexmk.exe
# PDFLATEX_PATH=
# BIBTEX_PATH=
LATEX_TIMEOUT=600          # first compiles may download packages
